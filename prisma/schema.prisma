datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(USER)
  phone         String?
  company       String?
  designation   String?
  accounts        Account[]
  sessions        Session[]
  products        Product[]
  imports         ImportedProduct[]
  userSessions    UserSession[]
  cartItems       CartItem[]
  paymentMethods  PaymentMethod[]
  transactions    Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id         String   @id @default(cuid())
  userId     String
  deviceType String   @default("desktop")
  deviceName String
  browser    String
  os         String
  ipAddress  String
  location   String
  lastActive DateTime @default(now())
  isCurrent  Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Product {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  image             String
  gallery           String[]  @default([])
  price             Float
  unit              String    @default("kg")
  originCountry     String
  rating            Float     @default(5.0)
  reviewsCount      Int       @default(0)
  availableQuantity Int
  minOrderQty       Int       @default(1)
  description       String?   @db.Text
  category          String    @default("Agricultural")
  exporterName      String?
  exporterRating    Float?
  exporterShipments Int       @default(0)
  portOfLoading     String?
  leadTime          String?
  hsCode            String?
  packaging         String?
  certifications    String[]  @default([])
  shelfLife         String?
  specs             Json?

  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model ImportedProduct {
  id               String    @id @default(cuid())
  productId        String
  name             String
  image            String
  price            Float
  unit             String?   @default("kg")
  rating           Float?    @default(5.0)
  originCountry    String
  importedQuantity Int
  importedAt       DateTime  @default(now())

  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  quantity  Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
}

model PaymentMethod {
  id            String   @id @default(cuid())
  userId        String
  type          String
  brand         String
  name          String
  last4         String
  accountNumber String?
  providerName  String?
  accountType   String?
  expDate       String?
  bankName      String?
  swiftCode     String?
  isDefault     Boolean  @default(false)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  amount      Float
  currency    String   @default("BDT")
  description String
  status      String   @default("COMPLETED")
  referenceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
